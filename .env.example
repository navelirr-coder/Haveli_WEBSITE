# Every enquiry is written to a SQLite database before any notification is sent.
# Defaults to data/enquiries.db. Point this at persistent storage when deploying.
ENQUIRY_DATABASE_PATH=data/enquiries.db

# Optional: forward each enquiry to an HTTPS service you control.
ENQUIRY_WEBHOOK_URL=
ENQUIRY_WEBHOOK_TOKEN=

# WhatsApp notifications. Configure ONE provider.
# CallMeBot (quickest for a personal number): message the bot once to get a key.
WHATSAPP_CALLMEBOT_APIKEY=
# Meta WhatsApp Cloud API.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Where notifications are sent. Defaults to the studio number.
WHATSAPP_TO=+917387416789
